generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  MT5
  BINANCE
  BYBIT
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeSource {
  MT5_WEBHOOK
  MT5_IMPORT
  MANUAL
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum SoloStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum SoloRole {
  HOST
  GUEST
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  displayTimezone String           @default("Asia/Ho_Chi_Minh")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  accounts        TradingAccount[]
  tags            Tag[]
}

model TradingAccount {
  id              String    @id @default(cuid())
  userId          String
  name            String
  broker          String?
  platform        Platform  @default(MT5)
  accountNumber   String
  currency        String    @default("USD")
  initialBalance  Decimal   @default(0) @db.Decimal(18, 2)
  brokerTimezone  String    @default("Europe/Athens")
  displayTimezone String    @default("Asia/Ho_Chi_Minh")
  webhookSecret   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades          Trade[]
  syncLogs        SyncLog[]
  candles         Candle[]

  @@unique([userId, platform, accountNumber])
}

model Trade {
  id                String         @id @default(cuid())
  accountId         String
  externalId        String
  symbol            String
  direction         TradeDirection
  volume            Decimal        @db.Decimal(18, 8)
  openTime          DateTime
  closeTime         DateTime
  holdingSeconds    Int
  openPrice         Decimal        @db.Decimal(18, 8)
  closePrice        Decimal        @db.Decimal(18, 8)
  stopLoss          Decimal?       @db.Decimal(18, 8)
  takeProfit        Decimal?       @db.Decimal(18, 8)
  initialStopLoss   Decimal?       @db.Decimal(18, 8)
  initialRiskAmount Decimal?       @db.Decimal(18, 2)
  rMultiple         Decimal?       @db.Decimal(10, 4)
  isManualRisk      Boolean        @default(false)
  grossPnl          Decimal        @db.Decimal(18, 2)
  commission        Decimal        @default(0) @db.Decimal(18, 2)
  swap              Decimal        @default(0) @db.Decimal(18, 2)
  netPnl            Decimal        @db.Decimal(18, 2)
  note              String?        @db.Text
  source            TradeSource
  rawPayload        Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tags              TradeTag[]

  @@unique([accountId, externalId])
  @@index([accountId, closeTime])
  @@index([accountId, symbol])
}

model Tag {
  id        String     @id @default(cuid())
  userId    String
  name      String
  color     String     @default("#6366f1")
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    TradeTag[]

  @@unique([userId, name])
}

model TradeTag {
  tradeId   String
  tagId     String

  trade     Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag       Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@index([tagId])
}

model SyncLog {
  id            String         @id @default(cuid())
  accountId     String
  source        TradeSource
  status        SyncStatus
  fileName      String?
  insertedCount Int            @default(0)
  updatedCount  Int            @default(0)
  skippedCount  Int            @default(0)
  errorMessage  String?        @db.Text
  createdAt     DateTime       @default(now())

  account       TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model Candle {
  id        String         @id @default(cuid())
  accountId String
  symbol    String
  timeframe String
  timestamp DateTime
  open      Decimal        @db.Decimal(18, 8)
  high      Decimal        @db.Decimal(18, 8)
  low       Decimal        @db.Decimal(18, 8)
  close     Decimal        @db.Decimal(18, 8)
  volume    Decimal?       @db.Decimal(18, 8)

  account   TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol, timeframe, timestamp])
  @@index([accountId, symbol, timeframe, timestamp])
}

// Solo 1v1 giữa bạn bè: đánh vàng giả lập trên web, cùng vốn demo, ai ROI% cao hơn thắng. App chỉ ghi sổ cược.
model SoloChallenge {
  id              String            @id @default(cuid())
  code            String            @unique
  title           String?
  status          SoloStatus        @default(WAITING)
  durationMinutes Int
  startingCapital Decimal           @db.Decimal(18, 2)
  stakeAmount     Decimal           @default(0) @db.Decimal(18, 2)
  stakeUnit       String            @default("đồng")
  startTime       DateTime?
  endTime         DateTime?
  winnerId        String?
  settledAt       DateTime?
  createdAt       DateTime          @default(now())

  participants    SoloParticipant[]
}

model SoloParticipant {
  id          String         @id @default(cuid())
  challengeId String
  displayName String
  role        SoloRole
  token       String
  finalNetPnl Decimal?       @db.Decimal(18, 2)
  finalRoiPct Decimal?       @db.Decimal(10, 4)
  createdAt   DateTime       @default(now())

  challenge   SoloChallenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  positions   SoloPosition[]

  @@unique([challengeId, role])
}

model SoloPosition {
  id            String          @id @default(cuid())
  participantId String
  side          TradeDirection
  lots          Decimal         @db.Decimal(10, 2)
  entryPrice    Decimal         @db.Decimal(18, 4)
  stopLoss      Decimal?        @db.Decimal(18, 4)
  takeProfit    Decimal?        @db.Decimal(18, 4)
  openTime      DateTime        @default(now())
  exitPrice     Decimal?        @db.Decimal(18, 4)
  closeTime     DateTime?
  closeReason   String?
  netPnl        Decimal?        @db.Decimal(18, 2)

  participant   SoloParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}
